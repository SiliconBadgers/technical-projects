// File:        lint_waivers.vlt
// Author:      Isaac Hagedorn
// Date:        2026-10-08
// Description: Verilator lint waivers for sb_systolic_tile.
`verilator_config

// File names fixed by the spec; modules carry the sb_ prefix.
lint_off -rule DECLFILENAME -file "*/rtl/*.sv"

// Outputs of the last column (a_h) and last row (w_v) go nowhere.
lint_off -rule UNUSEDSIGNAL -file "*/rtl/tile_top.sv" -match "*'a_h'*"
lint_off -rule UNUSEDSIGNAL -file "*/rtl/tile_top.sv" -match "*'w_v'*"

// SRAM black box: ports only.
lint_off -rule UNUSEDSIGNAL -file "*/macros/sb_sram_256x8.v"
lint_off -rule UNDRIVEN     -file "*/macros/sb_sram_256x8.v"
